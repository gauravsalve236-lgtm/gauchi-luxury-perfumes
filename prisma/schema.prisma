generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  notes        String?
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  cartItems    CartItem[]
  auditLogs    AuditLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String
  street      String
  apartment   String?
  city        String
  state       String
  postalCode  String
  country     String   @default("India")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id           String    @id @default(uuid())
  name         String
  slug         String    @unique
  description  String?
  imageUrl     String?
  displayOrder Int       @default(0)
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Product {
  id              String           @id @default(uuid())
  name            String
  slug            String           @unique
  subtitle        String?
  description     String
  fragranceFamily String // "Oud", "Fresh & Aquatic", "Floral & Fruity", "Warm & Woody", "Oriental & Amber", etc.
  gender          String // "Unisex", "Men", "Women"
  isFeatured      Boolean          @default(false)
  isBestSeller    Boolean          @default(false)
  isNewArrival    Boolean          @default(false)
  isPublished     Boolean          @default(true)
  topNotes        String // e.g. "Bergamot, Pink Pepper, Sicilian Lemon"
  middleNotes     String // e.g. "Damask Rose, Incense, Cedarwood"
  baseNotes       String // e.g. "Cambodian Oud, Amber, Vanilla, White Musk"
  howToUse        String?
  ingredients     String?
  displayOrder    Int              @default(0)
  categoryId      String?
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  qrCampaigns     QrCampaign[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProductVariant {
  id          String              @id @default(uuid())
  productId   String
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  size        String // e.g. "20ml", "60ml", "100ml", "Discovery Gift Set"
  sku         String              @unique
  price       Float
  mrp         Float
  stock       Int                 @default(0)
  isDefault   Boolean             @default(false)
  movements   InventoryMovement[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  alt          String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model InventoryMovement {
  id             String         @id @default(uuid())
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityChange Int
  previousStock  Int
  newStock       Int
  reason         String // "SALE", "RESTOCK", "DAMAGE", "RETURN", "INITIAL"
  referenceId    String?
  createdAt      DateTime       @default(now())
}

model Coupon {
  id                   String    @id @default(uuid())
  code                 String    @unique
  description          String?
  discountType         String // "PERCENTAGE", "FIXED", "FREE_SHIPPING"
  discountValue        Float
  minPurchase          Float     @default(0)
  maxDiscount          Float?
  usageLimit           Int?
  usageCount           Int       @default(0)
  perCustomerLimit     Int       @default(1)
  startDate            DateTime  @default(now())
  expiryDate           DateTime?
  isActive             Boolean   @default(true)
  applicableCategories String? // Comma-separated or JSON category slugs
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model Order {
  id                     String               @id @default(uuid())
  orderNumber            String               @unique
  userId                 String?
  user                   User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestEmail             String?
  guestName              String?
  guestPhone             String?
  subtotal               Float
  discount               Float                @default(0)
  couponCode             String?
  shippingFee            Float                @default(0)
  tax                    Float                @default(0)
  total                  Float
  paymentMethod          String // "COD", "RAZORPAY", "CASHFREE"
  paymentStatus          String // "PENDING", "PAID", "FAILED", "REFUNDED"
  orderStatus            String // "PENDING", "CONFIRMED", "PROCESSING", "PACKED", "SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED", "REFUNDED"
  paymentGatewayOrderId  String?
  paymentGatewayPaymentId String?
  paymentSignature       String?
  trackingNumber         String?
  courierName            String?
  shippingAddressJson    String // Stored snapshot of shipping address
  internalNotes          String?
  cancelReason           String?
  items                  OrderItem[]
  statusHistory          OrderStatusHistory[]
  reviews                Review[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantSize String
  unitPrice   Float
  quantity    Int
  total       Float
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  notes     String?
  changedBy String?
  createdAt DateTime @default(now())
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerName       String
  customerEmail      String?
  rating             Int // 1 to 5
  title              String?
  comment            String
  isVerifiedPurchase Boolean  @default(false)
  isApproved         Boolean  @default(false)
  adminResponse      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model CartItem {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, variantId])
}

model QrCampaign {
  id               String       @id @default(uuid())
  code             String       @unique // e.g. "black-oud-60ml", "wild-nectar-60ml"
  title            String
  productId        String?
  product          Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantSize      String? // e.g. "60ml", "20ml"
  marketplaceSource String      @default("GAUCHI_BOX") // "GAUCHI_BOX", "AMAZON", "FLIPKART"
  amazonReviewUrl  String?
  flipkartReviewUrl String?
  isActive         Boolean      @default(true)
  scanCount        Int          @default(0)
  reviewClickCount Int          @default(0)
  feedbackCount    Int          @default(0)
  scanEvents       QrScanEvent[]
  feedbackList     QrFeedback[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model QrScanEvent {
  id         String     @id @default(uuid())
  campaignId String
  campaign   QrCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipHash     String?
  referer    String?
  createdAt  DateTime   @default(now())
}

model QrFeedback {
  id                  String     @id @default(uuid())
  campaignId          String
  campaign            QrCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerName        String
  customerEmail       String?
  customerPhone       String?
  rating              Int // 1 to 5
  feedback            String
  preferredFamily     String?
  hasMarketingConsent Boolean    @default(false)
  createdAt           DateTime   @default(now())
}

model NewsletterSubscriber {
  id                  String   @id @default(uuid())
  email               String   @unique
  phone               String?
  birthday            String? // MM-DD
  preferredFamily     String?
  hasMarketingConsent Boolean  @default(true)
  isSubscribed        Boolean  @default(true)
  source              String   @default("WEBSITE") // "WEBSITE", "QR_CODE", "CHECKOUT"
  createdAt           DateTime @default(now())
}

model ContentBlock {
  id           String   @id @default(uuid())
  key          String   @unique // e.g. "hero_banner", "brand_story", "shipping_policy", "announcement_bar"
  title        String
  content      String // Markdown or plain text
  metadataJson String? // JSON settings such as buttons, subtext, images, links
  updatedAt    DateTime @updatedAt
}

model StoreSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "currency", "free_shipping_threshold", "flat_shipping_rate", "cod_enabled", "razorpay_enabled", "gst_percentage"
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String // e.g. "PRODUCT_UPDATE", "PRICE_CHANGE", "ORDER_STATUS_UPDATE", "COUPON_CREATE"
  entity      String // e.g. "Product", "Order", "Coupon"
  entityId    String?
  detailsJson String?
  createdAt   DateTime @default(now())
}
